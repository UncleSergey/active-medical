# Lead delivery configuration
# Never commit real tokens or API keys. Keep them in the hosting provider's secret store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_EMAIL_TO=
RESEND_API_KEY=

# Optional local preview fallback for /manus-storage/* assets.
# Leave empty in production when the built-in storage API is configured.
MANUS_STORAGE_FALLBACK_URL=

# Required by the Manus runtime in production.
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
JWT_SECRET=
VITE_APP_ID=
OWNER_OPEN_ID=

# Optional analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# The known Telegram chat id for the current bot conversation is 2115296326.
# Confirm it belongs to the intended clinic administrator before setting it in production.
# TELEGRAM_CHAT_ID=2115296326

# Notes:
# - TELEGRAM_CHAT_ID is taken from message.chat.id returned by Telegram getUpdates.
# - LEAD_EMAIL_TO is the clinic administrator's receiving email address.
# - RESEND_API_KEY is created in the Resend dashboard and must not be committed.
# - Use a newly rotated TELEGRAM_BOT_TOKEN because the previous token was exposed in chat.
